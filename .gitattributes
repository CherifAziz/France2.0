# Conserver les octets des archives primaires et leurs empreintes, sans nettoyage.
data/raw/** -text -whitespace
# Exception héritée : blob Git LF, fichier de travail CRLF lors de la reprise.
data/raw/04/isora_FRA_all_indicators.csv text eol=crlf -whitespace
# Lot 2 : conserver les octets des sorties dont les manifestes donnent l'empreinte.
data/international/04[a-d]_* -text whitespace=cr-at-eol
data/risques/*lot2* -text whitespace=cr-at-eol
sources/registre_04[a-d].csv -text whitespace=cr-at-eol
sources/04_manifestes_cache.json -text whitespace=cr-at-eol
figures/04_* -text -whitespace
livrables/dossier_recherche_lot2.* -text whitespace=cr-at-eol
# Les notes assemblées gardent des LF sur tous les systèmes.
recherche/04[a-d]_*.md text eol=lf
recherche/04_synthese_fonctions.md text eol=lf
recherche/00_verification*lot2.md text eol=lf
